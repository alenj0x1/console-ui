{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Console UI",
  "version": "0.1.0",
  "identifier": "dev.alejandro.consoleui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: http://cui.localhost cui:"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
