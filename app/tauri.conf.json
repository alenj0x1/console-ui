{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Console UI",
  "version": "0.1.0",
  "identifier": "dev.alejandro.consoleui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: http://cui.localhost cui:; media-src http://cui.localhost cui:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "alenj0x1",
    "shortDescription": "Usa Windows con un control de videojuegos",
    "longDescription": "Cursor asistido, teclado en pantalla y una pantalla de inicio tipo consola para usar todo Windows desde el sillón con un control.",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 alenj0x1 · MIT License",
    "license": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  }
}
